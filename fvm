#!/bin/bash
# ForthVM launcher script

set -e

SCRIPT_DIR="$(dirname "$0")"
STATS=""
QUIET=""
NORMALIZE=""
FILE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    -s)
      STATS="-1 STATS? !"
      shift
      ;;
    -Q)
      QUIET="-1 QUIET? !"
      shift
      ;;
    -N)
      NORMALIZE="-1 NORMALIZE? !"
      shift
      ;;
    -h|--help)
      echo "Usage: fvm [options] <command>"
      echo ""
      echo "Commands:"
      echo "  run <file.hvm>    Run a .hvm file"
      echo "  test              Run the test suite"
      echo ""
      echo "Options:"
      echo "  -s         Show statistics (MIPS)"
      echo "  -Q         Quiet mode"
      echo "  -N         Full normalization (reduce inside lambdas)"
      echo "  -h, --help Show this help"
      echo ""
      echo "Examples:"
      echo "  fvm run examples/test_add.hvm"
      echo "  fvm -s run examples/test_add.hvm"
      echo "  fvm -N -s run examples/identity.hvm"
      echo "  fvm test"
      exit 0
      ;;
    run)
      shift
      if [[ $# -eq 0 ]]; then
        echo "Error: 'run' requires a filename"
        exit 1
      fi
      FILE="$1"
      shift
      ;;
    test)
      # Run test suite
      FILE=""
      FORTH_CMD="$STATS $QUIET $NORMALIZE RUN-TESTS bye"
      ;;
    *)
      echo "Unknown argument: $1"
      echo "Use 'fvm --help' for usage information"
      exit 1
      ;;
  esac
done

# Check if we have a file to run or are running tests
if [[ -n "$FILE" ]]; then
  # Check if file exists
  if [[ ! -f "$FILE" ]]; then
    echo "Error: File not found: $FILE"
    exit 1
  fi

  # Convert to absolute path
  FILE_ABS="$(cd "$(dirname "$FILE")" && pwd)/$(basename "$FILE")"
  FORTH_CMD="$STATS $QUIET $NORMALIZE S\" $FILE_ABS\" RUN-FILE bye"
elif [[ "$FORTH_CMD" == "$STATS $QUIET $NORMALIZE RUN-TESTS bye" ]]; then
  # Test command already set
  :
else
  echo "Error: No file specified and not running tests"
  echo "Use 'fvm --help' for usage information"
  exit 1
fi

# Run from src directory
cd "$SCRIPT_DIR/src"
exec gforth fvm.fs -e "$FORTH_CMD"
